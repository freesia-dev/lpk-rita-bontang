# Salin ke environment server (atau jalankan dengan variabel ini).
PORT=3000
NODE_ENV=production
# Akun superadmin pertama (hanya dipakai saat database masih kosong).
# Jika ADMIN_PASSWORD kosong, password acak dibuat dan disimpan di data/admin-credentials.txt
ADMIN_EMAIL=admin@lpkrita.id
ADMIN_PASSWORD=
# Lokasi database & file upload
DATA_DIR=./data
